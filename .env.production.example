# ============================================================
#  Zo'r team — SERVER sozlamalari
#
#  Serverda bu faylni .env nomi bilan nusxalab to'ldiring:
#     cp .env.production.example .env
#     nano .env
#
#  Bu fayl hech qachon git'ga qo'shilmaydi.
# ============================================================

# --- Domen va HTTPS ---
# Domen serverning IP manziliga yo'naltirilgan bo'lishi shart (A yozuvi)
DOMAIN="hr.zorteam.uz"
# Let's Encrypt sertifikat muddati haqida ogohlantirish keladigan email
ACME_EMAIL="muslimbekae@gmail.com"

# --- Ma'lumotlar bazasi ---
POSTGRES_USER="zorteam"
POSTGRES_DB="zorteam"
# Uzun tasodifiy parol yarating:  openssl rand -base64 32
POSTGRES_PASSWORD=""

# --- Xavfsizlik ---
# Admin panel sessiyalari uchun kalit:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="ZOR_BU_robot"

# Webhook rejimi (serverda tavsiya etiladi — long polling'dan tezroq va barqaror).
# Domen ishlagach to'ldiring, aks holda bo'sh qoldiring.
TELEGRAM_WEBHOOK_URL=""
# Webhook uchun maxfiy token:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=""

# --- Vaqt mintaqasi ---
TZ="Asia/Tashkent"

# --- Ijtimoiy tarmoq API (keyinroq to'ldiriladi) ---
YOUTUBE_API_KEY=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
