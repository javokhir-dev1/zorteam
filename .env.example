# ============================================================
#  Zo'r team HR — muhit sozlamalari
#  Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring
# ============================================================

# --- Ma'lumotlar bazasi ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zorteam?schema=public"

# --- Redis (rejalashtiruvchi va navbat uchun) ---
REDIS_URL="redis://localhost:6379"

# --- Backend ---
API_PORT=4000
# Admin panel sessiyasi uchun maxfiy kalit (uzun tasodifiy satr)
JWT_SECRET="bu-qiymatni-albatta-almashtiring"
JWT_EXPIRES_IN="12h"

# --- Telegram bot ---
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=""
# Bot username (@ belgisisiz), Mini App havolasi uchun
TELEGRAM_BOT_USERNAME=""
# Mini App manzili (HTTPS bo'lishi SHART, localhost faqat test uchun)
MINIAPP_URL="http://localhost:3000/app"
# Webhook rejimi uchun (production). Bo'sh bo'lsa long polling ishlatiladi
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Fayl saqlash (fotolar) ---
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Vaqt mintaqasi ---
TZ="Asia/Tashkent"

# --- Frontend ---
# Bo'sh qoldiring: API so'rovlari web ilova manzilidan o'tadi (Next.js proksi).
# Faqat backend alohida domenda tursa to'ldiring.
NEXT_PUBLIC_API_URL=""
API_PROXY_TARGET="http://localhost:4000"

# --- Ijtimoiy tarmoq API (2-bosqichda to'ldiriladi) ---
YOUTUBE_API_KEY=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
