# Barcha matn fayllari omborda LF bilan saqlanadi.
# Windows'da ishlaganda avtomatik CRLF ga o'giriladi, serverda (Linux) LF qoladi.
* text=auto eol=lf

*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
